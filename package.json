{
  "name": "gateway-http-modular",
  "version": "1.0.0",
  "description": "Gateway HTTP Modular, Reutilizable, Standalone y Configurable para microservicios y frontends.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:mcp": "node scripts/validate-mcp-setup.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docker:build": "docker build -f docker/Dockerfile -t gateway-http:latest ."
  },
  "keywords": [
    "api-gateway",
    "reverse-proxy",
    "rate-limiting",
    "middleware",
    "fastify",
    "typescript"
  ],
  "author": "Antigravity Dev Team",
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "undici": "^6.26.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
